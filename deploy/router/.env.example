# 从锁定的官方源导入镜像后，填入本机 docker image inspect 的不可变 ID。
NEW_API_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
TOOLS_IMAGE=
# 以下值必须在服务器生成，实际 .env 权限 0600，禁止提交。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
TOOLS_DB_PASSWORD=
TOOLS_ADMIN_PASSWORD=
TOOLS_API_KEY=
TOOLS_JWT_SECRET=
# 回环、New API 桥接网关及 Cloudflare 官方代理网段（cloudflare-proxies.txt）。
TRUSTED_PROXIES=
